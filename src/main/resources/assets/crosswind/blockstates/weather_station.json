    "axis=x,pole_below=false": { "model": "crosswind:block/weather_station_base_none" },
    "axis=x,pole_below=true":  { "model": "crosswind:block/weather_station_base_below" },
    "axis=z,pole_below=false": { "model": "crosswind:block/weather_station_base_none" },
    "axis=z,pole_below=true":  { "model": "crosswind:block/weather_station_base_below" }
